{
  "prisma": {
    "seed": "ts-node apps/backend/prisma/seed.ts"
  },
  "scripts": {
    "prisma:generate": "prisma generate --schema apps/backend/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema apps/backend/prisma/schema.prisma",
    "prisma:seed": "prisma db seed --schema apps/backend/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema apps/backend/prisma/schema.prisma",
    "backend:build": "tsc",
    "backend:start": "node dist/apps/backend/src/server.js",
    "backend:dev": "npm run backend:build && npm run backend:start"
  },
  "dependencies": {
    "@multiavatar/multiavatar": "^1.0.7",
    "@prisma/client": "^6.19.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "framer-motion": "^12.35.0",
    "jsonwebtoken": "^9.0.3",
    "motion": "^12.35.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "prisma": "^6.19.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  }
}
