# Database (Neon: використовуйте connection string з консолі; для migrate інколи потрібен direct endpoint, не pooler)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-key-change-this-too"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV="development"

# CORS - Frontend URL
# URL фронтенду (Vercel тощо) для CORS. Приклад: https://your-app.vercel.app
CLIENT_URL=
